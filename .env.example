# ── Jumbo server configuration ────────────────────────────────────────────
# Copy to .env and fill in what you have. Nothing here is required to run the
# app: anything left blank simply turns that feature off and Jumbo says so in
# the UI. It never pretends a source is connected.

PORT=8787
PUBLIC_URL=http://localhost:8787          # where this API is reachable from the internet
WEB_ORIGIN=http://localhost:5173          # where the web app is served
SESSION_SECRET=                           # any long random string; signs OAuth state

# ── AI ────────────────────────────────────────────────────────────────────
# Powers meal photo analysis, pattern insights and future scenarios.
# https://platform.claude.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── YouTube ───────────────────────────────────────────────────────────────
# Powers Explore. Without it, Explore shows a setup notice rather than
# inventing creators or videos.
# https://developers.google.com/youtube/v3/getting-started
YOUTUBE_API_KEY=

# ── Health sources (OAuth 2.0) ────────────────────────────────────────────
# Register a redirect URI of  {PUBLIC_URL}/api/oauth/callback/{provider}
# for each one, e.g. http://localhost:8787/api/oauth/callback/oura

# https://developer.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# https://dev.fitbit.com/apps  (uses PKCE)
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# https://developer.withings.com
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# https://developer.garmin.com/health-api/overview/
# Garmin issues Health API endpoints with programme approval, so they are not
# hard-coded. Supply all five or Garmin stays unavailable.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_AUTHORIZE_URL=
GARMIN_TOKEN_URL=
GARMIN_API_BASE=

# ── Not configurable here ─────────────────────────────────────────────────
# Apple Health (HealthKit) and Android Health Connect are platform SDKs with
# no browser API. They connect only from the native app shell through the
# JumboNative bridge. See docs/NATIVE.md.

# ── Artwork ──────────────────────────────────────────────────────────
# Where the app loads photographs, illustrations, the mascot and logos
# from. Left blank, it serves them from this repository's own
# public/assets folder, which is where the placeholders live.
#
# Point it at the raw GitHub view of that folder to host the finished
# artwork there instead:
#   VITE_ASSET_BASE_URL=https://raw.githubusercontent.com/Sam-UX-Designer/Jumbo-ai-App/main/public/assets
#
# Every file this expects is listed in docs/ASSETS.md.
VITE_ASSET_BASE_URL=
